{
  "nome": "Reels da marca",
  "descricao": "Padrão para Reels/TikTok nas cores da marca: legenda central com palavra-chave destacada, zoom a cada corte, fotos/vídeos em tela cheia, trilha baixa e cartão final.",
  "formato": "9:16",
  "edicao": {
    "font": "{fonte}",
    "theme": {
      "accent": "{destaque}",
      "text": "{texto}",
      "brand": "{cor}",
      "card": "{cor}"
    },
    "silence": {
      "enabled": true,
      "threshold_db": -32,
      "min_silence": 0.4,
      "padding": 0.09
    },
    "subtitles": {
      "enabled": true,
      "style": "ref",
      "pos_y": 0.62,
      "bold": true,
      "max_words": 3,
      "italic": false
    },
    "punch_in": {
      "enabled": true,
      "levels": [
        1.0,
        1.12,
        1.0,
        1.22
      ],
      "max_hold": 3.5,
      "min_hold": 1.2
    },
    "replacements": "{substituicoes}"
  },
  "gancho": {
    "duracao": 2.6,
    "posicao": "top"
  },
  "broll": {
    "duracao_foto": 2.6,
    "duracao_video": 3.5,
    "layout": "full",
    "evitar_inicio": 2.5,
    "evitar_fim": 3.0,
    "intervalo_min": 2.5
  },
  "musica": {
    "volume": 0.14,
    "ducking": true,
    "fade_in": 0.8,
    "fade_out": 2.0
  },
  "encerramento": {
    "texto": "{chamada_final}",
    "subtexto": "{assinatura}",
    "duracao": 2.6
  },
  "capa": {
    "estilo": "faixa",
    "selo": "{assinatura}"
  },
  "legenda": {
    "cta": "{cta}",
    "hashtags": "{hashtags}"
  }
}
