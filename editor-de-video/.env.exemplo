# Domínio do cliente apontando para este servidor (registro A no DNS). Deixe vazio para testar por IP (HTTP).
DOMINIO=
# 1 quando houver DOMINIO (HTTPS). Com 0, o login funciona por HTTP para teste.
STUDIO_HTTPS=0
# Memória máxima do editor (ex.: 4g, 6g, 12g)
STUDIO_MEMORIA=6g
# Usuários: o instalar.sh cria o primeiro. Depois:
#   docker compose exec studio python web/acesso.py adicionar pessoa@cliente.com.br
